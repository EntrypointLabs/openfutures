# Public browser configuration. Use the same Supabase project in both URL variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WEBSITE_URL=

# Server only. NEVER prefix privileged keys/secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Exact browser origin, without a path. Set per deployment, including previews.
WAITLIST_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
REFERRAL_COOKIE_SECRET=
